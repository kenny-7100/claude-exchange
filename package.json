{
  "name": "claude-exchange-scripts",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "tokens:check": "tsx scripts/deploy-test-tokens.ts --check",
    "tokens:deploy": "tsx scripts/deploy-test-tokens.ts --deploy",
    "tokens:verify": "tsx scripts/deploy-test-tokens.ts --verify-only",
    "test:mock-prices": "tsx --test admin-ui/tests/mock-prices.test.ts",
    "mock-prices:check": "tsx scripts/check-mock-prices.ts",
    "idl:mock": "tsx scripts/generate-mock-idl.ts"
  },
  "dependencies": {
    "@metaplex-foundation/mpl-token-metadata": "3.4.0",
    "@metaplex-foundation/umi": "1.6.0",
    "@metaplex-foundation/umi-bundle-defaults": "1.6.0",
    "@metaplex-foundation/umi-web3js-adapters": "1.6.0",
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.99.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
